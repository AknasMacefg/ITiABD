        <mxCell id="HEWR0l6rr3aAgUkoga-0-21" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Эйфория&lt;/span&gt;&lt;/h1&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Эффектные демонстрации&lt;/li&gt;&lt;li&gt;Ложное допущение в основе&lt;/li&gt;&lt;li&gt;Искажение метрик&lt;/li&gt;&lt;li&gt;Игнорирование контекста&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
